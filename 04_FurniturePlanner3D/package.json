{
  "name": "furnitureplanner3d",
  "version": "0.1.3",
  "description": "Offline furniture layout and assembly plan printing",
  "author": "Furniture Planner 3D",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "build": "npm run dist"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.azimuth171.furnitureplanner3d",
    "productName": "Furniture Planner 3D",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "app/**/*",
      "!app/START_WINDOWS.bat",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "FurniturePlanner3D-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Furniture Planner 3D",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
